DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1023629880sa@
DB_NAME=pidapues
PORT=3000

# PIN de acceso para cada módulo del personal (cámbialos por unos propios).
# El PIN de admin también sirve para entrar a Cocina y Mesero.
PIN_COCINA=1234
PIN_MESERO=5678
PIN_ADMIN=9999


# Reseñas de ejemplo en el inicio: el servidor crea 3 si la tabla `resena` está
# vacía. Pon 0 para que no se creen (y borra las existentes con:
#   DELETE FROM resena WHERE id_pedido IS NULL;)
RESENAS_EJEMPLO=1

# Si la base de datos no tiene el modelo relacional (por ejemplo, quedó con el esquema antiguo),
# el servidor lo crea solo al arrancar. Pon 0 para que NO lo haga (y usa `--bd=init`).
AUTO_CREAR_BD=1
